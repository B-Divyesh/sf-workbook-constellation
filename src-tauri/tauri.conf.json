{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workbook Constellation",
  "version": "0.1.6",
  "identifier": "in.sociobot.workbook-constellation",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:4173",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist/app"
  },
  "app": {
    "windows": [{ "title": "Workbook Constellation", "width": 1280, "height": 820, "minWidth": 390, "minHeight": 640 }],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src https://api.sociobot.in https://api.github.com ipc: http://ipc.localhost; object-src 'none'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Map cross-sheet formula dependencies",
    "longDescription": "Read XLSX formulas locally, map sheet dependencies, flag risky formulas, and export a handoff report.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
